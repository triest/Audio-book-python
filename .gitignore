# Скачиваемые модели Silero — большие бинарники (40–150+ МБ), при первом
# запуске программа сама их скачивает, в репозитории не нужны.
*.pt

# Готовые аудиокниги — большие (десятки/сотни МБ), генерируются локально,
# в репозитории не нужны.
*.wav
*.mp3

# Отдельные папки с результатами озвучки (на случай других имён)
/audiobook
/audiobook_output
/pepel-pobedy

# Локальные настройки GUI — может содержать API-ключ Yandex SpeechKit,
# НЕ должен попадать в git.
fb2_reader_settings.json

# Логи, кэш Python, файлы IDE
*.log
__pycache__/
*.pyc
.idea/
